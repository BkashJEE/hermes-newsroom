# Omarchy Command Center — environment variables.
# Copy to .env (git-ignored) and fill in only what you use. The app runs with
# none of these set: the Hermes Newsroom falls back to synthetic fixture data.
#
# Every provider variable is read on the server only. Never prefix a secret
# with NEXT_PUBLIC_ — that would ship it to the browser.

# --- Newsroom behaviour -----------------------------------------------------
# Allow ?scenario=slow|empty|error|partial|stale|offline in production builds.
NEWSROOM_ENABLE_SCENARIOS=

# Live Hacker News AI discussions and public Hermes GitHub releases are enabled
# by liveSources: true in config/newsroom.local.json. Neither requires a key.

# --- Future live providers (not implemented yet; placeholders only) ---------

# Reddit (script app, read-only)
NEWSROOM_REDDIT_CLIENT_ID=
NEWSROOM_REDDIT_CLIENT_SECRET=
NEWSROOM_REDDIT_USER_AGENT=

# X API
NEWSROOM_X_BEARER_TOKEN=

# Facebook Graph API
NEWSROOM_FACEBOOK_ACCESS_TOKEN=

# RSS / official blogs / research feeds (comma-separated feed URLs)
NEWSROOM_RSS_FEEDS=

# Hermes Agent bridge (server-side): override automatic ~/.hermes discovery.
# URL is the loopback server base, e.g. http://127.0.0.1:8642 (no /v1 suffix).
# Each unset value falls back independently to the Hermes installation.
HERMES_API_URL=
HERMES_API_KEY=
